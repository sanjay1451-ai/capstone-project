{
  "info": {
    "name": "VoltTrade - Second-Hand Electronics Platform API",
    "description": "Comprehensive RESTful API collection for VoltTrade: User Auth, Products, Search & Filters, Barter Exchange, Orders, Reviews, Direct Messaging, Reports, and Admin Moderation.",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json"
  },
  "variable": [
    {
      "key": "baseUrl",
      "value": "http://localhost:8080/api",
      "type": "string"
    },
    {
      "key": "authToken",
      "value": "",
      "type": "string"
    }
  ],
  "item": [
    {
      "name": "00. System Health",
      "item": [
        {
          "name": "Live Health Check",
          "request": {
            "method": "GET",
            "header": [],
            "url": {
              "raw": "{{baseUrl}}/health",
              "host": ["{{baseUrl}}"],
              "path": ["health"]
            }
          }
        }
      ]
    },
    {
      "name": "01. Authentication & Users",
      "item": [
        {
          "name": "User Registration",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"name\": \"Alex Rivers\",\n  \"email\": \"alex.rivers@example.com\",\n  \"password\": \"Password123!\",\n  \"confirmPassword\": \"Password123!\",\n  \"phone\": \"+1-555-0192\",\n  \"address\": \"124 Tech Boulevard, San Francisco, CA\"\n}"
            },
            "url": {
              "raw": "{{baseUrl}}/auth/register",
              "host": ["{{baseUrl}}"],
              "path": ["auth", "register"]
            }
          }
        },
        {
          "name": "User Login",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"email\": \"alex.rivers@example.com\",\n  \"password\": \"Password123!\"\n}"
            },
            "url": {
              "raw": "{{baseUrl}}/auth/login",
              "host": ["{{baseUrl}}"],
              "path": ["auth", "login"]
            }
          }
        },
        {
          "name": "Get Current User Profile (Me)",
          "request": {
            "method": "GET",
            "header": [
              {
                "key": "Authorization",
                "value": "Bearer {{authToken}}"
              }
            ],
            "url": {
              "raw": "{{baseUrl}}/auth/me",
              "host": ["{{baseUrl}}"],
              "path": ["auth", "me"]
            }
          }
        },
        {
          "name": "Update User Profile",
          "request": {
            "method": "PUT",
            "header": [
              {
                "key": "Authorization",
                "value": "Bearer {{authToken}}"
              },
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"name\": \"Alex Rivers\",\n  \"phone\": \"+1-555-9999\",\n  \"address\": \"500 Silicon Valley Way, CA\",\n  \"profileImage\": \"https://images.unsplash.com/photo-1534528741775-53994a69daeb?w=150\"\n}"
            },
            "url": {
              "raw": "{{baseUrl}}/auth/profile",
              "host": ["{{baseUrl}}"],
              "path": ["auth", "profile"]
            }
          }
        }
      ]
    },
    {
      "name": "02. Categories",
      "item": [
        {
          "name": "Get All Categories",
          "request": {
            "method": "GET",
            "header": [],
            "url": {
              "raw": "{{baseUrl}}/categories",
              "host": ["{{baseUrl}}"],
              "path": ["categories"]
            }
          }
        }
      ]
    },
    {
      "name": "03. Products & Marketplace Search",
      "item": [
        {
          "name": "List All Products (with filters)",
          "request": {
            "method": "GET",
            "header": [],
            "url": {
              "raw": "{{baseUrl}}/products?category=Smartphones&minPrice=100&maxPrice=1000&sort=newest",
              "host": ["{{baseUrl}}"],
              "path": ["products"],
              "query": [
                { "key": "category", "value": "Smartphones" },
                { "key": "minPrice", "value": "100" },
                { "key": "maxPrice", "value": "1000" },
                { "key": "sort", "value": "newest" }
              ]
            }
          }
        },
        {
          "name": "Search Products Multi-field",
          "request": {
            "method": "GET",
            "header": [],
            "url": {
              "raw": "{{baseUrl}}/products/search?keyword=Apple&condition=EXCELLENT",
              "host": ["{{baseUrl}}"],
              "path": ["products", "search"],
              "query": [
                { "key": "keyword", "value": "Apple" },
                { "key": "condition", "value": "EXCELLENT" }
              ]
            }
          }
        },
        {
          "name": "Get Product By ID",
          "request": {
            "method": "GET",
            "header": [],
            "url": {
              "raw": "{{baseUrl}}/products/1",
              "host": ["{{baseUrl}}"],
              "path": ["products", "1"]
            }
          }
        },
        {
          "name": "Create Product Listing",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Authorization",
                "value": "Bearer {{authToken}}"
              },
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"title\": \"Apple iPhone 14 Pro - 256GB Space Black\",\n  \"description\": \"Pristine condition iPhone 14 Pro with 98% battery health. Includes original box, MagSafe case, and braided USB-C cable.\",\n  \"category\": \"Smartphones\",\n  \"brand\": \"Apple\",\n  \"model\": \"iPhone 14 Pro\",\n  \"condition\": \"LIKE_NEW\",\n  \"price\": 749.00,\n  \"originalPrice\": 999.00,\n  \"location\": \"San Francisco, CA\",\n  \"imageUrls\": [\n    \"https://images.unsplash.com/photo-1695048133142-1a20484d2569?w=800\"\n  ]\n}"
            },
            "url": {
              "raw": "{{baseUrl}}/products",
              "host": ["{{baseUrl}}"],
              "path": ["products"]
            }
          }
        },
        {
          "name": "Update Product Listing",
          "request": {
            "method": "PUT",
            "header": [
              {
                "key": "Authorization",
                "value": "Bearer {{authToken}}"
              },
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"title\": \"Apple iPhone 14 Pro - 256GB (Price Drop)\",\n  \"price\": 699.00,\n  \"condition\": \"LIKE_NEW\",\n  \"category\": \"Smartphones\"\n}"
            },
            "url": {
              "raw": "{{baseUrl}}/products/1",
              "host": ["{{baseUrl}}"],
              "path": ["products", "1"]
            }
          }
        },
        {
          "name": "Delete Product Listing",
          "request": {
            "method": "DELETE",
            "header": [
              {
                "key": "Authorization",
                "value": "Bearer {{authToken}}"
              }
            ],
            "url": {
              "raw": "{{baseUrl}}/products/1",
              "host": ["{{baseUrl}}"],
              "path": ["products", "1"]
            }
          }
        }
      ]
    },
    {
      "name": "04. Barter Exchanges",
      "item": [
        {
          "name": "Propose Device Exchange",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Authorization",
                "value": "Bearer {{authToken}}"
              },
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"targetProductId\": 2,\n  \"offeredProductId\": 1,\n  \"message\": \"Would you be open to trading your MacBook for my iPhone 14 Pro plus cash adjustment?\"\n}"
            },
            "url": {
              "raw": "{{baseUrl}}/exchanges",
              "host": ["{{baseUrl}}"],
              "path": ["exchanges"]
            }
          }
        },
        {
          "name": "Get Received Exchange Offers",
          "request": {
            "method": "GET",
            "header": [
              {
                "key": "Authorization",
                "value": "Bearer {{authToken}}"
              }
            ],
            "url": {
              "raw": "{{baseUrl}}/exchanges/received",
              "host": ["{{baseUrl}}"],
              "path": ["exchanges", "received"]
            }
          }
        },
        {
          "name": "Accept Exchange Proposal",
          "request": {
            "method": "PUT",
            "header": [
              {
                "key": "Authorization",
                "value": "Bearer {{authToken}}"
              }
            ],
            "url": {
              "raw": "{{baseUrl}}/exchanges/1/accept",
              "host": ["{{baseUrl}}"],
              "path": ["exchanges", "1", "accept"]
            }
          }
        }
      ]
    },
    {
      "name": "05. Buying & Order Management",
      "item": [
        {
          "name": "Create Order / Buy Now",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Authorization",
                "value": "Bearer {{authToken}}"
              },
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"productId\": 3,\n  \"quantity\": 1,\n  \"deliveryAddress\": \"124 Tech Boulevard, San Francisco, CA\"\n}"
            },
            "url": {
              "raw": "{{baseUrl}}/orders",
              "host": ["{{baseUrl}}"],
              "path": ["orders"]
            }
          }
        },
        {
          "name": "Get My Purchases",
          "request": {
            "method": "GET",
            "header": [
              {
                "key": "Authorization",
                "value": "Bearer {{authToken}}"
              }
            ],
            "url": {
              "raw": "{{baseUrl}}/orders/my-orders",
              "host": ["{{baseUrl}}"],
              "path": ["orders", "my-orders"]
            }
          }
        },
        {
          "name": "Update Order Status (Confirm / Ship / Deliver)",
          "request": {
            "method": "PUT",
            "header": [
              {
                "key": "Authorization",
                "value": "Bearer {{authToken}}"
              },
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"status\": \"SHIPPED\"\n}"
            },
            "url": {
              "raw": "{{baseUrl}}/orders/1/status",
              "host": ["{{baseUrl}}"],
              "path": ["orders", "1", "status"]
            }
          }
        }
      ]
    },
    {
      "name": "06. Reviews & Community Ratings",
      "item": [
        {
          "name": "Submit Product Review",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Authorization",
                "value": "Bearer {{authToken}}"
              },
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"productId\": 1,\n  \"rating\": 5,\n  \"comment\": \"Amazing device! Condition matched the listing photos exactly and battery health is pristine.\"\n}"
            },
            "url": {
              "raw": "{{baseUrl}}/reviews",
              "host": ["{{baseUrl}}"],
              "path": ["reviews"]
            }
          }
        },
        {
          "name": "Get Product Reviews",
          "request": {
            "method": "GET",
            "header": [],
            "url": {
              "raw": "{{baseUrl}}/reviews/product/1",
              "host": ["{{baseUrl}}"],
              "path": ["reviews", "product", "1"]
            }
          }
        }
      ]
    },
    {
      "name": "07. Buyer-Seller Messaging",
      "item": [
        {
          "name": "Send Direct Message",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Authorization",
                "value": "Bearer {{authToken}}"
              },
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"receiverId\": 2,\n  \"productId\": 1,\n  \"content\": \"Hi! Is this electronic item still available for pickup?\"\n}"
            },
            "url": {
              "raw": "{{baseUrl}}/messages",
              "host": ["{{baseUrl}}"],
              "path": ["messages"]
            }
          }
        },
        {
          "name": "Get Active Conversations",
          "request": {
            "method": "GET",
            "header": [
              {
                "key": "Authorization",
                "value": "Bearer {{authToken}}"
              }
            ],
            "url": {
              "raw": "{{baseUrl}}/messages/conversations",
              "host": ["{{baseUrl}}"],
              "path": ["messages", "conversations"]
            }
          }
        },
        {
          "name": "Get Message Stream With User",
          "request": {
            "method": "GET",
            "header": [
              {
                "key": "Authorization",
                "value": "Bearer {{authToken}}"
              }
            ],
            "url": {
              "raw": "{{baseUrl}}/messages/2",
              "host": ["{{baseUrl}}"],
              "path": ["messages", "2"]
            }
          }
        }
      ]
    },
    {
      "name": "08. Trust & Report System",
      "item": [
        {
          "name": "Report / Flag Listing",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Authorization",
                "value": "Bearer {{authToken}}"
              },
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"productId\": 4,\n  \"reason\": \"INCORRECT_INFO\",\n  \"details\": \"Photos show 256GB storage, but title says 1TB.\"\n}"
            },
            "url": {
              "raw": "{{baseUrl}}/reports",
              "host": ["{{baseUrl}}"],
              "path": ["reports"]
            }
          }
        }
      ]
    },
    {
      "name": "09. Admin Console & Moderation",
      "item": [
        {
          "name": "Get Platform KPI Stats",
          "request": {
            "method": "GET",
            "header": [
              {
                "key": "Authorization",
                "value": "Bearer {{authToken}}"
              }
            ],
            "url": {
              "raw": "{{baseUrl}}/admin/stats",
              "host": ["{{baseUrl}}"],
              "path": ["admin", "stats"]
            }
          }
        },
        {
          "name": "Get Users List",
          "request": {
            "method": "GET",
            "header": [
              {
                "key": "Authorization",
                "value": "Bearer {{authToken}}"
              }
            ],
            "url": {
              "raw": "{{baseUrl}}/admin/users",
              "host": ["{{baseUrl}}"],
              "path": ["admin", "users"]
            }
          }
        },
        {
          "name": "Update User Status (ACTIVE / SUSPENDED)",
          "request": {
            "method": "PUT",
            "header": [
              {
                "key": "Authorization",
                "value": "Bearer {{authToken}}"
              },
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"status\": \"SUSPENDED\"\n}"
            },
            "url": {
              "raw": "{{baseUrl}}/admin/users/1/status",
              "host": ["{{baseUrl}}"],
              "path": ["admin", "users", "1", "status"]
            }
          }
        },
        {
          "name": "Get Flagged Reports",
          "request": {
            "method": "GET",
            "header": [
              {
                "key": "Authorization",
                "value": "Bearer {{authToken}}"
              }
            ],
            "url": {
              "raw": "{{baseUrl}}/admin/reports",
              "host": ["{{baseUrl}}"],
              "path": ["admin", "reports"]
            }
          }
        },
        {
          "name": "Resolve Report",
          "request": {
            "method": "PUT",
            "header": [
              {
                "key": "Authorization",
                "value": "Bearer {{authToken}}"
              },
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"status\": \"RESOLVED\"\n}"
            },
            "url": {
              "raw": "{{baseUrl}}/admin/reports/1/status",
              "host": ["{{baseUrl}}"],
              "path": ["admin", "reports", "1", "status"]
            }
          }
        }
      ]
    }
  ]
}
