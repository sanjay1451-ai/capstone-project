# ===================================================================
# Second-Hand Electronics Trading Platform - Backend Environment Variables
# ===================================================================
# Copy this file to .env and replace the placeholder values with your
# actual Supabase PostgreSQL connection details.
#
# NOTE: Never commit your .env file containing real secrets to Git.
# ===================================================================

# Server Configuration
PORT=8080

# Supabase PostgreSQL Database Configuration
# Option A: Full Connection String (Recommended for Supabase)
# Find this in your Supabase Project Settings -> Database -> Connection string -> URI
# Example: postgresql://postgres.[project-ref]:[password]@aws-0-[region].pooler.supabase.com:6543/postgres?sslmode=require
SPRING_DATASOURCE_URL=jdbc:postgresql://localhost:5432/electronics_db?sslmode=prefer

# Option B: Discrete Parameters (Used if SPRING_DATASOURCE_URL is not set)
DB_HOST=localhost
DB_PORT=5432
DB_NAME=postgres
DB_USERNAME=postgres
DB_PASSWORD=your_supabase_database_password_here

# Supabase Pooling / SSL Configuration
DB_SSL_MODE=require

# CORS Configuration (Comma-separated list of allowed frontend origins)
CORS_ALLOWED_ORIGINS=http://localhost:5173,http://localhost:3000

# Security / JWT Configuration
# Key must be at least 256 bits (32 characters or Base64 encoded 256-bit string)
JWT_SECRET=404E635266556A586E3272357538782F413F4428472B4B6250645367566B5970
JWT_EXPIRATION_MS=86400000

# Active Spring Profile (dev, prod)
SPRING_PROFILES_ACTIVE=dev
